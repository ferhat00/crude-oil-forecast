er_email  = sender_email,\n    subject         = \"Crude Oil Forecast — Daily Update\",\n    body            = \"Pipeline complete. Figures attached.\",\n    file_paths      = [\n        f\"{FIGURES}/fan_chart.png\",\n        f\"{FIGURES}/predictive_density.png\",\n        f\"{FIGURES}/actual_vs_pred.png\",\n    ],\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-20T10:21:24.974858Z","iopub.execute_input":"2026-03-20T10:21:24.975198Z","iopub.status.idle":"2026-03-20T10:21:33.192839Z","shell.execute_reply.started":"2026-03-20T10:21:24.975144Z","shell.execute_reply":"2026-03-20T10:21:33.191443Z"}},"outputs":[{"name":"stdout","text":"Email sent to ferhat00@gmail.com\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}